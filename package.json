{
  "name": "malisa",
  "version": "2.6.1",
  "private": true,
  "type": "module",
  "description": "Malisa - AI web site Translator (Chrome & Firefox)",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:chrome": "node scripts/build.mjs chrome && node scripts/zip.mjs chrome",
    "build:firefox": "node scripts/build.mjs firefox && node scripts/zip.mjs firefox",
    "build:firefox-source": "node scripts/source-zip.mjs",
    "lint:firefox": "web-ext lint --source-dir dist/firefox",
    "lint:chrome": "web-ext lint --source-dir dist/chrome",
    "test:security": "node --test tests/security/",
    "run:firefox": "web-ext run --source-dir dist/firefox --firefox=firefox"
  },
  "devDependencies": {
    "archiver": "^7.0.1",
    "esbuild": "^0.25.0",
    "playwright": "1.64.1",
    "web-ext": "^10.8.0"
  }
}
